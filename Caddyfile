# ===========================================
# FROG MULTIPLAYER GAME
# ===========================================
frog.muazaoski.online {
    reverse_proxy froggame:3000
    
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets froggame:3000

    encode gzip zstd
    
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    
    # Prevent caching of HTML (so browser always gets latest)
    @html {
        path *.html /
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"
    
    # Allow caching of hashed assets (JS/CSS with hash in filename)
    @assets {
        path *.js *.css *.woff2 *.glb *.png *.jpg *.webp
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"
    
    log {
        output file /data/access.log
        format console
    }
}

www.frog.muazaoski.online {
    redir https://frog.muazaoski.online{uri} permanent
}

